<Window x:Class="FolderDeck.SelectFoldersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="追加するフォルダを選択" Width="620" Height="560" MinWidth="450" MinHeight="380" WindowStartupLocation="CenterOwner">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="追加するフォルダを選択" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="ParentPath" Grid.Row="1" Foreground="{StaticResource Muted}" Margin="0,12,0,15" TextWrapping="Wrap"/>
  <StackPanel Grid.Row="2" Margin="0,0,0,14"><TextBlock Text="登録するジョブの動作モード" Style="{StaticResource Label}"/><ComboBox x:Name="InitialModeCombo" SelectedIndex="0"><ComboBoxItem Content="通常バックアップ"/><ComboBoxItem Content="フォルダ構成のみ"/><ComboBoxItem Content="選択したフォルダ名のみ"/></ComboBox></StackPanel>
  <ListBox x:Name="FolderList" Grid.Row="3" Background="#34465B" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Text}" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Padding="8" Margin="5,7"/></DataTemplate></ListBox.ItemTemplate></ListBox>
  <Grid Grid.Row="4" Margin="0,18,0,0"><StackPanel Orientation="Horizontal"><Button Content="全選択" Click="All_Click" Padding="12,8" Margin="0,0,8,0"/><Button Content="全解除" Click="None_Click" Padding="12,8"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="キャンセル" IsCancel="True" Margin="0,0,8,0"/><Button Content="選択したフォルダを追加" Click="Ok_Click" Style="{StaticResource PrimaryButton}" IsDefault="True"/></StackPanel></Grid>
 </Grid>
</Window>
